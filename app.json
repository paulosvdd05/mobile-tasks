{
  "expo": {
    "name": "TesteTecnico",
    "slug": "TesteTecnico",
    "scheme": "testetecnico",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/iconTasks.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/iconTasks.png",
      "resizeMode": "contain",
      "backgroundColor": "#5C1FB8"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/iconTasks.png",
        "backgroundColor": "#5C1FB8"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/iconTasks.png"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
